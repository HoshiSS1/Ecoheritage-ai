generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           Int      @id @default(autoincrement())
  fullName     String
  email        String   @unique
  passwordHash String
  role         String   @default("User")
  avatarUrl    String?
  createdAt    DateTime @default(now())
  reviews      Review[]
}

model Heritage {
  id             Int      @id @default(autoincrement())
  name           String
  description    String?
  latitude       Float?
  longitude      Float?
  category       String?
  imageUrl       String?
  createdAt      DateTime @default(now())
  address        String?
  aqi            Int?
  bestTime       String?
  color          String?
  contact        String?
  folkTip        String?
  herbs          String?
  history        String?
  humidity       Int?
  level          String?
  medicinalPower String?
  rating         Float?
  regulations    String?
  reviewsCount   Int?     @default(0)
  slugId         String   @unique
  status         String?
  remedies       Remedy[]
  reviews        Review[]
}

model Remedy {
  id          Int       @id @default(autoincrement())
  heritageId  Int?
  name        String
  ingredients String?
  imageUrl    String?
  createdAt   DateTime  @default(now())
  benefits    String?
  category    String?
  imageEmoji  String?
  keywords    String?
  slugId      String    @unique
  steps       String?
  usage       String?
  heritage    Heritage? @relation(fields: [heritageId], references: [id], onDelete: Cascade)
}

model Review {
  id         Int       @id @default(autoincrement())
  userId     Int?
  heritageId Int?
  rating     Int
  comment    String?
  createdAt  DateTime  @default(now())
  guestName  String?
  heritage   Heritage? @relation(fields: [heritageId], references: [id], onDelete: Cascade)
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
